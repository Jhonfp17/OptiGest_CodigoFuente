<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Historial administrativo</title><link rel="stylesheet" href="${ctx}/Css/bootstrap.min.css"><link rel="stylesheet" href="${ctx}/Css/HistorialAdministrativo.css"><link rel="stylesheet" href="${ctx}/Css/ResponsiveBase.css?v=4"></head>
<body class="historial-page"><main class="container py-5 historial-wrap"><section class="historial-card"><div class="historial-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3"><div><h1 class="historial-title">Historial administrativo</h1><p class="historial-subtitle mb-0">Trazabilidad de las operaciones importantes.</p></div><a class="btn btn-volver" href="${ctx}/Configuracion">Volver</a></div>
<form class="row g-3 historial-filter" method="post" action="${ctx}/HistorialAdministrativo"><div class="col-md-3"><label class="form-label">Módulo</label><select class="form-select" name="entidad"><option value="">Todos</option><c:forEach var="e" items="${['Activos','Personal','Asignaciones','Mantenimiento','Proveedores']}"><option value="${e}" ${entidad == e ? 'selected' : ''}>${e}</option></c:forEach></select></div><div class="col-md-3"><label class="form-label">Acción</label><select class="form-select" name="accion"><option value="">Todas</option><option value="CREADO" ${accion == 'CREADO' ? 'selected' : ''}>Creado</option><option value="ACTUALIZADO" ${accion == 'ACTUALIZADO' ? 'selected' : ''}>Actualizado</option><option value="DESACTIVADO" ${accion == 'DESACTIVADO' ? 'selected' : ''}>Desactivado / retirado</option></select></div><div class="col-md-3"><label class="form-label">Buscar</label><input class="form-control" type="search" name="buscar" value="${busqueda}" placeholder="Nombre, documento, activo o proveedor"></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary btn-buscar w-100">Buscar</button></div></form>
<div class="table-responsive"><table class="table table-sm align-middle historial-table"><thead><tr><th>Fecha</th><th>Módulo</th><th>Nombre</th><th>Acción</th><th>Responsable</th><th>Motivo</th></tr></thead><tbody><c:forEach var="h" items="${historial}"><tr><td>${h.fecha}</td><td>${h.entidad}</td><td class="registro-nombre">${h.registroDescripcion}</td><td class="accion">${h.accion}</td><td>${h.usuarioNombre}</td><td>${h.motivo}</td></tr></c:forEach><c:if test="${empty historial}"><tr><td colspan="6" class="text-center historial-empty">No hay registros para el filtro seleccionado.</td></tr></c:if></tbody></table></div></section></main></body></html>
