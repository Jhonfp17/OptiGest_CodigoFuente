<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Historial administrativo</title><link rel="stylesheet" href="${ctx}/Css/bootstrap.min.css"><link rel="stylesheet" href="${ctx}/Css/ResponsiveBase.css?v=4"></head>
<body><main class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Historial administrativo</h1><p class="text-muted mb-0">Cambios, anulaciones y desactivaciones conservados por el sistema.</p></div><a class="btn btn-outline-secondary" href="${ctx}/Configuracion">Volver</a></div>
<form class="row g-3 mb-4" method="post" action="${ctx}/HistorialAdministrativo"><div class="col-md-3"><label class="form-label">Módulo</label><select class="form-select" name="entidad"><option value="">Todos</option><c:forEach var="e" items="${['Activos','Personal','Asignaciones']}"><option value="${e}" ${entidad == e ? 'selected' : ''}>${e}</option></c:forEach></select></div><div class="col-md-3"><label class="form-label">Acción</label><select class="form-select" name="accion"><option value="">Todas</option><option value="CREADO" ${accion == 'CREADO' ? 'selected' : ''}>Creado</option><option value="ACTUALIZADO" ${accion == 'ACTUALIZADO' ? 'selected' : ''}>Actualizado</option><option value="DESACTIVADO" ${accion == 'DESACTIVADO' ? 'selected' : ''}>Desactivado / retirado</option></select></div><div class="col-md-3"><label class="form-label">Buscar</label><input class="form-control" type="search" name="buscar" value="${busqueda}" placeholder="Nombre, documento o código"></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Buscar</button></div></form>
<div class="table-responsive"><table class="table table-striped table-sm align-middle"><thead><tr><th>Fecha</th><th>Módulo</th><th>Nombre</th><th>Acción</th></tr></thead><tbody><c:forEach var="h" items="${historial}"><tr><td>${h.fecha}</td><td>${h.entidad}</td><td>${h.registroDescripcion}</td><td>${h.accion}</td></tr></c:forEach><c:if test="${empty historial}"><tr><td colspan="4" class="text-center text-muted">No hay registros para el filtro seleccionado.</td></tr></c:if></tbody></table></div></main></body></html>
